+/*
+ * Track the complete x86 IDT asynchronous IRQ wrapper, including entry and
+ * exit work outside HARDIRQ_OFFSET/the IRQ stack. Keep this state with the
+ * interrupted task: irqentry_exit() may schedule or migrate that task.
+ * Call only at IRQ-disabled noinstr boundaries; do not reset on KCOV mode
+ * changes. Synchronous exception wrappers deliberately do not use this API.
+ */
+static __always_inline void kcov_async_irq_enter(void)
+{
+	WRITE_ONCE(current->kcov_async_irq_depth,
+		   READ_ONCE(current->kcov_async_irq_depth) + 1);
+	barrier();
+}
+
+static __always_inline void kcov_async_irq_exit(void)
+{
+	barrier();
+	WRITE_ONCE(current->kcov_async_irq_depth,
+		   READ_ONCE(current->kcov_async_irq_depth) - 1);
+}
 
