 MODULE_DESCRIPTION("Kconc synchronous regmap mutex-domain test entry");
 MODULE_LICENSE("GPL");
+
+#if IS_ENABLED(CONFIG_KCONC_REGMAP_KUNIT_TEST)
+#include "kconc-regmap-kunit.h"
