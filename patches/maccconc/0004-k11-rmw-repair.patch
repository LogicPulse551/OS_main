From: Competition team
Subject: [PATCH] K11 rmw caller repair and shared-body KUnit

Base: Linux 2fc2e45b0cd75cd56f252a0872a6d039f46cc42b plus accepted K10 family.
Team-authored repair of the declared caller misuse, not an upstream regmap bug fix.
The native request ABI and logical operation mode are unchanged.
KUnit uses the pinned upstream framework; test bodies are team-authored GPL-2.0-only.

--- a/drivers/base/regmap/kconc-regmap.c
+++ b/drivers/base/regmap/kconc-regmap.c
@@ -4,8 +4,9 @@
  * Base: Linux 2fc2e45b0cd75cd56f252a0872a6d039f46cc42b (MAccConc tree).
  * The unmodified regmap-ram.c is Copyright (c) 2023 Arm Ltd, GPL-2.0.
  * Team code below supplies lifecycle/ABI glue, not a replacement regmap.
- * SPLIT deliberately misuses separately locked read/write for a logical update;
- * UPDATE_BITS uses the upstream API whose single lock protects the whole RMW.
+ * K11 keeps SPLIT requests but serializes the complete read/write operation
+ * with one map-wide sleeping mutex, also used by UPDATE_BITS requests.
+ * The observed before/after values remain the actual regmap read/write values.
  * This test device does not model physical hardware, IRQ or DMA behavior.
  */
 #include <linux/compat.h>
@@ -26,6 +27,7 @@
 
 struct kconc_regmap_context {
 	struct mutex guard;
+	struct mutex update_guard;
 	struct regmap *map;
 	struct regmap_ram_data *ram;
 	u32 state;
@@ -81,10 +83,9 @@
 }
 
 /*
- * SPLIT reaches this after regmap_read() released its spinlock and restored
- * IRQ state, before regmap_write() acquires that lock again. UPDATE_BITS reaches
- * it before regmap_update_bits(), without claiming to interrupt its locked RMW.
- * No lifecycle mutex is held. Each logical role owns a distinct slot.
+ * Both modes reach this before update_guard and any real regmap API.
+ * No lifecycle/update/regmap lock is held. Pausing a task here lets the peer
+ * finish a complete update. Each logical role owns a distinct slot.
  * Bind control to the checkpoint store below, not to a bus callback or lock.
  */
 static noinline int kconc_regmap_checkpoint(struct kconc_regmap_role *role,
@@ -177,12 +178,42 @@
 	return 0;
 }
 
+/* Actual synchronous ioctl body; the KUnit fixture calls this same code. */
+static int kconc_execute_operation(struct kconc_regmap_context *ctx,
+				   struct kconc_regmap_role *role,
+				   const struct kconc_regmap_op *request)
+{
+	unsigned int before = 0;
+	unsigned int after = 0;
+	int ret;
+
+	ret = kconc_regmap_checkpoint(role, request->epoch);
+	if (ret)
+		return ret;
+	/* Shared by both request modes, including mixed-mode callers. */
+	mutex_lock(&ctx->update_guard);
+	if (request->mode == KCONC_REGMAP_MODE_SPLIT) {
+		ret = regmap_read(ctx->map, request->reg, &before);
+		role->before = before;
+		if (!ret) {
+			after = (before & ~request->mask) | (request->value & request->mask);
+			ret = regmap_write(ctx->map, request->reg, after);
+		}
+		role->after = after;
+		role->values_valid = !ret;
+	} else {
+		/* The upstream API does not expose its locked before/after. */
+		ret = regmap_update_bits(ctx->map, request->reg,
+					 request->mask, request->value);
+	}
+	mutex_unlock(&ctx->update_guard);
+	return ret;
+}
+
 static long kconc_operation(struct kconc_regmap_context *ctx, void __user *arg)
 {
