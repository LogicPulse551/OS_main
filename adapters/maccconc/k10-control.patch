 static void kcov_alloc_multi(int num_kcov_insts) {
 #ifdef K03_EVIDENCE
   if (k03_enabled)
     k03_control = (K03Control*)SYSCHK(mmap(NULL, sizeof(K03Control), PROT_READ|PROT_WRITE,
         MAP_SHARED|MAP_ANONYMOUS, -1, 0));
 #endif
   kcov_insts = (struct kcov_inst*)SYSCHK(mmap(NULL, sizeof(*kcov_insts)*num_kcov_insts, PROT_READ|PROT_WRITE, MAP_SHARED|MAP_ANONYMOUS, -1, 0));
   for (int i=0; i<num_kcov_insts; i++) {
     kcov_insts[i].fd = SYSCHK(open("/sys/kernel/debug/kcov", O_RDWR));
     SYSCHK(ioctl(kcov_insts[i].fd, KCOV_INIT_TRACE, COVER_SIZE));
     kcov_insts[i].cover = (unsigned long *)SYSCHK(mmap(NULL, COVER_SIZE * sizeof(unsigned long),
             PROT_READ | PROT_WRITE, MAP_SHARED, kcov_insts[i].fd, 0));
   }
 }
 
 static pthread_barrier_t rtic_init_barrier, rtic_finish_barrier;
 static void *rtic_thread_fn(void *inner_) {
   bool inner = *(bool*)inner_;
   pin_to(1);
   SYSCHK(ioctl(kcov_insts[1].fd, KCOV_ENABLE, 3/*KCOV_TRACE_MEMORY_ACCESS*/));
   pthread_barrier_wait(&rtic_init_barrier);
+#ifdef K03_EVIDENCE
+  if (k03_enabled && !k10_wait_a_ready()) {
+    // The gate was never called. Keep its default fields and preserve an
+    // explicit child failure rather than executing an uncontrolled callback.
+    static const char message[] = "K10: slot A readiness budget exhausted\n";
+    (void)write(STDERR_FILENO, message, sizeof(message) - 1);
+    _exit(125);
+  }
+#endif
   if (inner) {
 #ifdef K03_EVIDENCE
     if (k03_enabled) k03_control->gate_called = 1;
     int gate_rc = ioctl(kcov_insts[0].fd, KCOV_SPINWAIT_DI_FLAG, 0);
     if (k03_enabled) {
       k03_control->gate_rc = gate_rc;
       k03_control->gate_errno = gate_rc < 0 ? errno : 0;
+    }
+    if (gate_rc < 0) {
+      // Exit the entire child process; waiting at the finish barrier could
+      // deadlock with the peer. The parent still exports shared gate/status.
+      static const char message[] = "K10: gate failure; callback not executed\n";
+      (void)write(STDERR_FILENO, message, sizeof(message) - 1);
+      _exit(125);
     }
 #else
     ioctl(kcov_insts[0].fd, KCOV_SPINWAIT_DI_FLAG, 0);
 #endif
   }
 
   if (k03_enabled) k03_control->k08_slot_tids[1] = syscall(SYS_gettid);
   __atomic_store_n(&kcov_insts[1].cover[0], 0, __ATOMIC_RELAXED);
   // MEASUREMENT STARTS HERE
   k08_run_slot(1);
   // MEASUREMENT ENDS HERE
   kcov_insts[1].cover_n = __atomic_load_n(&kcov_insts[1].cover[0], __ATOMIC_RELAXED);
 #ifdef K03_EVIDENCE
   if (k03_enabled) k03_control->b_done = 1;
 #endif
   if (inner) {
 #ifdef K03_EVIDENCE
     if (k03_enabled) k03_control->b_wake_called = 1;
     int wake_rc = ioctl(kcov_insts[0].fd, KCOV_WAKE_DI_FLAG, 1);
     if (k03_enabled) {
       k03_control->b_wake_rc = wake_rc;
       k03_control->b_wake_errno = wake_rc < 0 ? errno : 0;
     }
     SYSCHK(wake_rc);
 #else
     SYSCHK(ioctl(kcov_insts[0].fd, KCOV_WAKE_DI_FLAG, 1));
 #endif
   }
 
   pthread_barrier_wait(&rtic_finish_barrier);
   return NULL;
 }
 static unsigned long SPIN_LIMIT = 1000000;
 static void run_testcase_in_child(bool sequential, bool t2_is_inner) {
 #ifdef K03_EVIDENCE
   if (k03_enabled) {
     memset(k03_control, 0, sizeof(*k03_control));
     k03_control->child_status = -1;
     k03_control->gate_rc = k03_control->a_wake_rc = k03_control->b_wake_rc = k03_control->reset_rc = -999;
     kcov_insts[0].cover_n = kcov_insts[1].cover_n = 0;
     fflush(NULL);
   }
 #endif
   pid_t child = SYSCHK(fork());
   if (child != 0) {
     int wstatus;
     int waited = SYSCHK(waitpid(child, &wstatus, 0));
 #ifdef K03_EVIDENCE
     if (k03_enabled) {
       k03_control->child_status = wstatus;
       k03_control->waitpid_result = waited;
     }
 #endif
     return;
   }
 
 #ifdef K03_EVIDENCE
   if (k03_enabled) {
     if (!freopen(k03_child_stdout_path, "wx", stdout)) err(1, "K03 child stdout");
     if (!freopen(k03_child_stderr_path, "wx", stderr)) err(1, "K03 child stderr");
   }
 #endif
   if (pthread_barrier_init(&rtic_init_barrier, NULL, 2))
     errx(1, "pthread_barrier_init");
   if (pthread_barrier_init(&rtic_finish_barrier, NULL, 2))
     errx(1, "pthread_barrier_init");
   test_setup();
   pthread_t thread;
   if (pthread_create(&thread, NULL, rtic_thread_fn, &t2_is_inner))
     errx(1, "pthread_create");
 
   pin_to(0);
 
   pthread_barrier_wait(&rtic_init_barrier);
 
   // should be the last syscall before we start
   SYSCHK(ioctl(kcov_insts[0].fd, KCOV_ENABLE, KCOV_TRACE_MEMORY_ACCESS));
 
-  if (k03_enabled) k03_control->k08_slot_tids[0] = syscall(SYS_gettid);
+  if (k03_enabled) {
+    k03_control->k08_slot_tids[0] = syscall(SYS_gettid);
+    __atomic_store_n(&k03_control->k10_a_ready, 1U, __ATOMIC_RELEASE);
+  }
   __atomic_store_n(&kcov_insts[0].cover[0], 0, __ATOMIC_RELAXED);
   // MEASUREMENT STARTS HERE
   k08_run_slot(0);
   // MEASUREMENT ENDS HERE
   kcov_insts[0].cover_n = __atomic_load_n(&kcov_insts[0].cover[0], __ATOMIC_RELAXED);
 #ifdef K03_EVIDENCE
   if (k03_enabled) k03_control->a_done = 1;
 #endif
   if (sequential) {
 #ifdef K03_EVIDENCE
     if (k03_enabled) k03_control->a_wake_called = 1;
     int wake_rc = ioctl(kcov_insts[0].fd, KCOV_WAKE_DI_FLAG, 0);
     if (k03_enabled) {
       k03_control->a_wake_rc = wake_rc;
       k03_control->a_wake_errno = wake_rc < 0 ? errno : 0;
     }
     SYSCHK(wake_rc);
 #else
     SYSCHK(ioctl(kcov_insts[0].fd, KCOV_WAKE_DI_FLAG, 0));
 #endif
   }
 
   pthread_barrier_wait(&rtic_finish_barrier);
   if (pthread_join(thread, NULL))
     errx(1, "pthread_join");
 #ifdef K03_EVIDENCE
   if (k03_enabled) k03_control->reset_called = 1;
   int reset_rc = ioctl(kcov_insts[0].fd, KCOV_RESET_DI_FLAGS, 0);
   if (k03_enabled) {
     k03_control->reset_rc = reset_rc;
     k03_control->reset_errno = reset_rc < 0 ? errno : 0;
   }
   SYSCHK(reset_rc);
 #else
   SYSCHK(ioctl(kcov_insts[0].fd, KCOV_RESET_DI_FLAGS, 0));
 #endif
   test_end();
   exit(0);
 }
 
 #ifdef __cplusplus
 struct DIStack {
   std::vector<struct kcov_di_stack_elem> elems;
   enum di_stack_type type;
   unsigned int flagidx;
   struct kcov_di_stack to_uapi() {
     return (struct kcov_di_stack) {
       .elems = (uintptr_t)elems.data(),
       .num_elems = (unsigned int)elems.size(),
       .type = type,
       .flagidx = flagidx
     };
   }
 };
 
 void prep_di(size_t thread_idx, std::vector<DIStack> &di_stacks_vec, int sync_bits_fd) {
   std::vector<struct kcov_di_stack> uapi_stacks;
   std::vector<DIStack> di_stack_vec_(di_stacks_vec);
   std::sort(di_stack_vec_.begin(), di_stack_vec_.end(), [](DIStack& a, DIStack& b) {
     return a.type != DI_STACK_WAKE_POST && b.type == DI_STACK_WAKE_POST;
   });
   for (DIStack& di_stack : di_stack_vec_)
     uapi_stacks.push_back(di_stack.to_uapi());
   struct kcov_set_di_arg di_arg = {
     .stacks = (uintptr_t)uapi_stacks.data(),
     .num_stacks = (unsigned int)uapi_stacks.size(),
     .sync_bits_fd = sync_bits_fd,
     .spin_limit = SPIN_LIMIT
   };
   SYSCHK(ioctl(kcov_insts[thread_idx].fd, KCOV_SET_DI, &di_arg));
 }
 #endif
