      "zstd"
    ],
    "guest_required_features": [
      "Compiler accepting GNU C23 or the validated GNU2x subset with stdbool.h, and the used GNU C++23 features",
      "make and pkg-config",
      "libdw/elfutils and libelf development headers",
      "Capstone development headers",
      "Guest Makefile LIBS overridden to -ldw -lcapstone -lelf; GUI remains on Debian host"
    ],
    "package_resolution": "Resolve and record exact binary packages during K02; these names are dependency requirements, not an installed-package lock.",
    "openeuler_guest_packages": [
      "gcc",
      "gcc-c++",
      "make",
      "pkgconf-pkg-config",
      "elfutils-devel",
      "elfutils-libelf-devel",
      "capstone-devel",
      "tar",
      "gzip",
      "patch"
    ]
  },
  "runtime": {
    "guest_userspace": "openEuler 24.03 LTS SP3 x86_64",
    "default_cpus": 4,
    "gui_transport": "AF_VSOCK SOCK_STREAM",
    "host_vsock_cid": 2,
    "guest_vsock_cid": 5,
    "vsock_port": 1262702422,
    "required_qemu_device": "vhost-vsock-pci,guest-cid=5",
    "debugfs": "/sys/kernel/debug",
    "kcov_device": "/sys/kernel/debug/kcov",
    "mount_tmpfs": "/tmp",
    "guest_kernel_addresses": "CONFIG_RANDOMIZE_BASE=n; retain matching unstripped vmlinux",
    "target_cpus": [
      0,
      1
    ],
    "kcov_buffer_words_per_instance": 16777216,
    "spin_limit": 1000000,
    "uapi_expected_x86_64": {
      "unsigned_long_bytes": 8,
      "memory_access_record_bytes": 40,
      "kcov_di_stack_bytes": 24,
      "kcov_set_di_arg_bytes": 24
    }
  },
  "validation_boundary": "Immutable source/configuration lock only. K02 must validate toolchain, effective Kconfig, guest dynamic ABI and VSOCK; K03 must run actual tracing and A-B-A control."
