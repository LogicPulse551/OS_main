  "build": {
    "llvm": {
      "generator": "Ninja",
      "build_type": "Release",
      "projects": [
        "clang",
        "lld"
      ],
      "targets": [
        "X86"
      ],
      "default_parallel_jobs": 2,
      "bootstrap_linker": "Debian lld; exact package version captured with K02 build evidence"
    },
    "kernel": {
      "arch": "x86_64",
      "llvm": "absolute path to pinned LLVM install bin directory",
      "kcflags": "-fno-optimize-sibling-calls -mllvm -sanitizer-coverage-prune-blocks=false",
      "fragment": "configs/kernel/maccconc-x86_64.fragment",
      "base_config": "x86_64_defconfig + kvm_guest.config; verify effective config after olddefconfig",
      "target_features": "built-in, not modules",
      "build_target": "bzImage (also builds vmlinux); no loadable modules: upstream entry/exit callbacks are not exported",
      "optional_static_context_analysis": "Disabled: pinned Clang cannot resolve callback parameter bdev in blk_holder_ops release_capability annotations. This is a compile-time diagnostic limitation; required KCOV/KASAN instrumentation remains enabled."
    },
    "userspace": {
      "gui": "build and run on Debian host",
      "executors": "build against openEuler guest userspace; do not copy unverified Debian-linked binaries",
      "upstream_c_standard": "gnu23",
      "upstream_cxx_standard": "gnu++23",
      "guest_compiler_feature_check_required": true,
      "guest_link_libraries": [
        "dw",
        "capstone",
        "elf"
      ],
      "guest_c_standard_policy": "Probe gnu23; if unavailable record failure and use gnu2x for these checked sources only."
    }
  },
  "dependencies": {
    "debian_host_packages": [
      "git",
